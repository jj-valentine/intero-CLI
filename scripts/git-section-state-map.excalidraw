      "updated": 1779800336072,
      "link": null,
      "locked": false,
      "text": "Working tree (✱3 +1 ?2), stash, and PR are ALWAYS shown alongside whichever priority level is active.\nThey occupy separate slots on the line — they don't compete with sync/safety/operation for the same space.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Working tree (✱3 +1 ?2), stash, and PR are ALWAYS shown alongside whichever priority level is active.\nThey occupy separate slots on the line — they don't compete with sync/safety/operation for the same space.",
      "autoResize": true,
      "lineHeight": 1.2,
      "syncedAt": "2026-05-26T13:05:56.424Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-05-26T13:05:56.416Z"
    },
